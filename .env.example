# Supabase 项目配置（复制为 .env.local 并填入真实值）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 仅服务端使用（Route Handler 直查数据库 + Storage 上传），切勿暴露到浏览器
SUPABASE_SERVICE_ROLE_KEY=
# 站点公开 URL（用于 SEO canonical / Open Graph / sitemap，例如 https://thinkingnotes.help）
# Vercel 部署时可省略，它会自动用 VERCEL_PROJECT_PRODUCTION_URL
# SITE_URL=
